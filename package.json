{
  "name": "zyn-motion-library",
  "version": "1.0.0",
  "description": "ZYN 可复用动效镜头库：相册、叠卡、拼贴、布局变形与创意转场",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.533",
    "@remotion/media": "4.0.533",
    "@remotion/transitions": "4.0.533",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.533",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio --no-open",
    "check": "tsc --noEmit",
    "render:slide": "remotion render src/index.ts WholePageSlideDemo previews/whole-page-slide.mp4 --codec=h264 --crf=17",
    "render:float": "remotion render src/index.ts FloatingPolaroidsDemo previews/floating-polaroids.mp4 --codec=h264 --crf=17",
    "render:carousel": "remotion render src/index.ts PerspectiveCarouselDemo previews/perspective-carousel.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --color-space=bt709",
    "render:stack": "remotion render src/index.ts FlipCardStackDemo previews/curved-card-stack.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --color-space=bt709",
    "render:stickers": "remotion render src/index.ts StickerSwapDemo previews/sticker-swap.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --color-space=bt709",
    "render:panel": "remotion render src/index.ts ThumbnailPanelDemo previews/thumbnail-panel.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --color-space=bt709",
    "render:glitch": "remotion render src/index.ts ChromaticGlitchDemo previews/chromatic-glitch.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --color-space=bt709",
    "render:window": "remotion render src/index.ts MediaWindowCardDemo previews/media-window-card.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --color-space=bt709",
    "render:book": "remotion render src/index.ts FoldPageAlbumDemo previews/fold-page-album.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --color-space=bt709",
    "render:aperture": "remotion render src/index.ts CenterApertureFlashDemo previews/center-aperture-flash.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --color-space=bt709"
  }
}
